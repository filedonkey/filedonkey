/* FileDonkey - dark skin.
 *
 * Palette taken from the design mockups:
 *
 *   #1E1F22  panel / window          #E8E9EC  text, primary
 *   #191A1D  deeper surfaces         #C7CBD1  text, bright secondary
 *   #141518  deepest                 #A9AEB6  text, secondary
 *   #26282C  rows, raised            #8D929A  text, muted
 *   #2A2C31  hover                   #7E838B  text, micro-labels
 *   #2F3238  controls                #5F646C  text, disabled
 *   #34363B  borders, raised         #0C0D0F  text, on a light fill
 *   #3D4046  borders, fields
 *   #2B2D31  borders, hairline       #4EC97A  mounted
 *                                    #E0A33C  busy
 *                                    #E0564C  error     (unused so far)
 *
 * Two of the accent three are on the device list's state dots. The error red
 * has nowhere to go yet: a mount that fails takes its row with it - LocalNode
 * forgets the peer so the next broadcast can start it over - so there is no
 * failed state left on screen to colour.
 */

/* Type and colour for everything. Deliberately no background here: a bare
 * QWidget background rule paints over every child widget in the app.
 *
 * The family is named here, once, and nowhere below: everything in the window
 * is Inconsolata, bundled in the resources and registered by applyFonts().
 * This rule used to name Segoe UI, which dressed the Windows build and left
 * the other two falling past it to the `sans-serif` generic.
 *
 * Naming it here rather than leaving it to the application font is what makes
 * macOS agree. The Cocoa platform theme fills Qt's class-to-font hash with the
 * system font for most widget classes, and QApplication::font(widget) reads
 * that hash before it reaches the font QApplication::setFont() installed - so
 * the app font alone dressed the Windows build and left the mac one in San
 * Francisco. A family in a stylesheet is applied per widget by
 * QStyleSheetStyle, which outranks both.
 *
 * Two spellings of it, because the semibold cut carries a typographic family
 * of "Inconsolata" and a legacy one of "Inconsolata SemiBold", and which of
 * the two a platform backend registers is its own business - Windows takes
 * both, CoreText has been known to take only the legacy one. The rest of the
 * list is what is left if the resource ever fails to register: Cascadia Mono
 * and Consolas on Windows, and the generic, which is Menlo on macOS and
 * whatever fontconfig answers with on Linux. */
QWidget {
    color: #E8E9EC;
    font-family: "Inconsolata", "Inconsolata SemiBold", "Cascadia Mono", Consolas, monospace;
    font-size: 15px;
}

/* The window frame is drawn by the three widgets stacked inside it, not by the
 * window: #titleBar owns the top two corners, QStatusBar the bottom two, and
 * #centralwidget the straight run between them. Each carries the same 1px
 * #34363B outline down its own outer edges so the three read as one border.
 *
 * QMainWindow itself must paint nothing - it is translucent (see
 * WA_TranslucentBackground in MainWindow) and any fill here would put the
 * square corners straight back. */

QMainWindow {
    background: transparent;
}

/* The shadow caster. Never seen directly - the title bar, the content and the
 * status bar cover it - so the only thing that matters here is that its shape
 * matches theirs, or the blur it throws would not follow the frame's corners.
 * The fill is the corner colour, so a rounding difference of a pixel at the
 * radius reads as the frame rather than as a seam. */

QWidget#windowShadow {
    background: #191A1D;
    border-radius: 8px;
}

QMainWindow > QWidget#centralwidget {
    background: #1E1F22;
    border-left: 1px solid #34363B;
    border-right: 1px solid #34363B;
}

/* ----------------------------------------------------------------- title bar
 * Same two tokens as the status bar, so the window is bookended by them. The
 * native title bar is off - see Qt::FramelessWindowHint in MainWindow - and
 * this sits in the slot the (empty) menu bar used to have. */

QWidget#titleBar {
    background: #191A1D;
    border-top: 1px solid #34363B;
    border-left: 1px solid #34363B;
    border-right: 1px solid #34363B;
    border-bottom: 1px solid #2B2D31;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QLabel#titleBarTitle {
    color: #A9AEB6;
    font-size: 12px;
}

/* The rule between the title and the caption buttons. Same grey as the window's
 * own border, like the status bar's - sized in titlebar.cpp. */
QWidget#titleBarSeparator { background: #34363B; width: 1px; }

/* ------------------------------------------------------------- the view tabs
 * The two pages of the window - the device list and the settings - picked from
 * the inner end of the bar, in front of the separator. Icon only: a 36px bar
 * with a title already in it has no room for two labels, and the tooltips set
 * in titlebar.cpp are what name them.
 *
 * Unlike the caption buttons beside them these do not run the height of the
 * bar. They are inset from its top and flush with its bottom - sized and
 * aligned in titlebar.cpp - so they need none of the border patching a
 * full-height button does, and only the top two corners are rounded: a tab is
 * open at the edge it shares with the page it opens.
 *
 * Only `background` differs between the states below, and deliberately: a
 * border or padding that changed with the state would resize the content box
 * and shift the glyph inside it by the difference, so the icon would jump as
 * the pointer crossed the tab or as the selection moved between the two.
 *
 * The glyph changes with the fill, but from its own file rather than from
 * here - an icon takes no colour from `color:`. Three per tab: #A9AEB6 idle,
 * #E8E9EC under the pointer, and, because the current tab's fill is the light
 * one, #191A1D - the bar's own background - when it is selected. See
 * device_list*.svg and settings*.svg, and read them together with the fills
 * below. */

QToolButton#deviceListTab,
QToolButton#settingsTab {
    background: transparent;
    border: none;

    /* A tab's box is pushed down the bar by the run of bar above it, so an
     * icon centred in that box sits below the centre of the bar - off the line
     * the app icon and the caption glyphs are all on. This padding is what
     * puts it back: the same 6px the tab is inset from the top by, taken off
     * the bottom of its content box instead, which leaves that box centred on
     * the bar even though the box drawn around it is not. Both numbers come
     * from titlebar.cpp - TITLEBAR_HEIGHT less its two borders, less
     * TITLEBAR_TAB_HEIGHT - so a change to either has to be answered here. */
    padding: 0px 0px 2px 0px;

    /* The bottom two are spelled out as zero rather than left unsaid, so that
     * a shorthand `border-radius` added above could not quietly round them. */
    border-top-left-radius: 6px;
    border-top-right-radius: 6px;
    border-bottom-left-radius: 0px;
    border-bottom-right-radius: 0px;

    border-bottom: 1px solid #2B2D31;
}

QToolButton#deviceListTab:hover,
QToolButton#settingsTab:hover { background: #2F3238; }

/* The one light fill in the window. It is what makes the current tab the first
 * thing found in the bar, and it is why the glyph on it is drawn dark. */
QToolButton#deviceListTab:checked,
QToolButton#settingsTab:checked { background: #C7CBD1; }

/* Two pseudo-states, so this outranks both rules above and the current tab
 * still answers the pointer instead of sitting inert under it. Brighter rather
 * than darker: it has to stay light enough for the dark glyph to read. */
QToolButton#deviceListTab:checked:hover,
QToolButton#settingsTab:checked:hover { background: #E8E9EC; }

/* Size comes from the layout, not from here - see captionButton() in
 * titlebar.cpp. Square, flush and full height, the way Windows draws them, so
 * the hover fill runs the whole button rather than floating inside it.
 *
 * Only the fills live here. The glyphs are SVG icons, one file per state under
 * assets/caption_*.svg, and an icon does not take its colour from `color:` -
 * so the greys below are backgrounds, and the marks drawn on top of them are
 * coloured in the files. The two palettes have to be read together. */

QToolButton#minimiseBtn,
QToolButton#maximiseBtn,
QToolButton#closeBtn {
    background: transparent;
    border: none;

    /* Full height means these run over the bar's own top border and bottom
     * hairline, so a hover fill would otherwise punch a 46px hole in the
     * window's outline. Carrying the same two lines themselves closes it. */
    border-top: 1px solid #34363B;
    border-bottom: 1px solid #2B2D31;

    border-radius: 0px;
    padding: 0px;
}

/* The one exception: this button's outer corner is the window's, so its hover
 * fill has to follow the same curve or it squares the corner off on hover.
 * 7px rather than 8 - the bar's radius measured inside its 1px border. */
QToolButton#closeBtn { border-top-right-radius: 7px; }

QToolButton#minimiseBtn:hover   { background: #2F3238; }
QToolButton#minimiseBtn:pressed { background: #2A2C31; }

/* Maximise is present but dead - the window is a fixed size. It has to read as
 * unavailable at a glance rather than as a button that did nothing when
 * clicked, so its glyph is drawn in the disabled grey used for dead menu
 * entries (#4A4E55, in caption_maximise.svg). Nothing to set here: the button
 * keeps the transparent background above, and Qt sends a disabled widget
 * neither hover nor pressed, which is what we want anyway. */

/* The one place the error red earns its keep so far. */
QToolButton#closeBtn:hover   { background: #C42B1C; }
QToolButton#closeBtn:pressed { background: #B2271A; }

/* ---------------------------------------------------------------- status bar */

QStatusBar {
    background: #191A1D;
    border-top: 1px solid #2B2D31;
    border-left: 1px solid #34363B;
    border-right: 1px solid #34363B;
    border-bottom: 1px solid #34363B;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    min-height: 30px;
}

/* Without this every widget added to the bar gets a sunken 3D frame drawn
 * around it by the native style. */
QStatusBar::item { border: 0px; }

/* ------------------------------------------------- the status bar's contents
 * One line at each end. On the left the version and the stage the project is
 * in, which used to be part of the window title; on the right this machine's
 * own address and, built by the device list and put here by the window, the
 * same state dot the rows carry and a count of them. The transfer counters
 * that used to sit on the right are on the rows now - see #deviceDetail below.
 *
 * Every one of them is the same muted 11px, so no end reads as the more
 * important and none competes with the list above them. */

QLabel#versionLbl {
    color: #8D929A;
    font-size: 12px;
}

QWidget#statusEndpoint { background: transparent; }

/* An address is a run of digits, and the four groups only read as four if each
 * digit takes the same width - the reason this label named a mono family back
 * when the rest of the bar was in the desktop's UI font. The whole window is
 * mono now, so there is nothing left here to say but the colour and size. */
QLabel#endpointLbl {
    color: #8D929A;
    font-size: 12px;
}

/* The same grey as the window's own border - it is a rule inside the frame,
 * not a lighter hint of one. Sized in mainwindow.cpp, like the dots. */
QWidget#statusSeparator { background: #34363B; }

QWidget#deviceSummary { background: transparent; }

QLabel#deviceCountLbl {
    color: #8D929A;
    font-size: 12px;
}

/* ---------------------------------------------------------- the device list
 * Everything between the title bar and the status bar: a scrolling column of
 * rows, or the empty state while nothing has been found. It carries no heading
 * of its own - the window is the list, and the count that would have titled it
 * is in the status bar instead.
 *
 * Sizes that decide the shape of a thing - the 30px badge, the 6px dots - are
 * set in devicelist.cpp rather than here, because QSS sizes the content box
 * and each border would have to be subtracted from the number by hand. What is
 * left here is colour, type and roundness. */

/* The stack the title bar's tabs switch, and the second of its two pages. Both
 * transparent so that what shows behind them is #centralwidget's own fill and
 * not a second one. */

QStackedWidget#contentStack,
QWidget#settingsPage,
QWidget#settingsContent,
QScrollArea#settingsScroll {
    background: transparent;
    border: none;
}

/* ------------------------------------------------------------- the settings
 * A column of rows, each a label and the field it names - laid out by a form
 * layout in settingspage.cpp, which is what keeps the labels in a column of
 * their own as more rows arrive.
 *
 * The label is the secondary grey and the field the primary near-white: the
 * value is what is being read, and the label only says which value it is. Both
 * at 12px, the size the second line of a device row is set in - a form of rows
 * at the window's own 15px would fill the page with two of them. */

QLabel#settingsLabel { 
    color: #A9AEB6;
    font-size: 12px;
}

/* The one text field in the window. Sunk into the page rather than raised off
 * it - the deeper #191A1D the title bar and status bar are painted in, so it
 * reads as somewhere to type instead of as another button.
 *
 * The placeholder needs no rule: Qt derives its colour from the text colour
 * above, at half alpha, which is the muted grey it would otherwise be given
 * here. */

QLineEdit#settingsInput {
    background: #191A1D;
    border: 1px solid #3D4046;
    border-radius: 6px;
    color: #E8E9EC;
    font-size: 12px;
    padding: 4px 8px;
    selection-background-color: #2F3238;
    selection-color: #E8E9EC;
}

/* The only state it has. Lifted to the grey the disabled text is in, which is
 * as far as a border can be brought up without becoming a second thing to
 * read. */
QLineEdit#settingsInput:focus { border-color: #5F646C; }

/* A value that is shown rather than typed - the shared root, so far. The same
 * near-white the fields are set in, because it is the same kind of thing: what
 * this setting holds. No border and no fill, because there is nothing to type
 * into - the button beside it is what changes it. */

QLabel#settingsPath {
    background: transparent;
    color: #E8E9EC;
    font-size: 12px;
}

/* The button that opens the folder dialog. The design's secondary button: a
 * raised fill inside a border a shade lighter than the fields', which is what
 * separates a thing to press from a thing to read.
 *
 * It has to name itself past the plain QPushButton rule further down, which
 * dresses the dialog buttons and gives them a min-width no row here has room
 * for. */

QPushButton#settingsChooseBtn {
    background: #26282C;
    border: 1px solid #3D4046;
    border-radius: 6px;
    color: #C7CBD1;
    font-size: 12px;
    padding: 4px 12px;
    min-width: 0px;
}

QPushButton#settingsChooseBtn:hover   { background: #2F3238; }
QPushButton#settingsChooseBtn:pressed { background: #212226; }

/* The third column of the settings page's rows, and of the manual connect
 * dialog's: the button that puts a field back to the value it started with,
 * shown only while that field holds something else. One rule for both, because
 * both are built by revertButton() in revertbutton.h and are meant to be the
 * same button - see the note there.
 *
 * Nothing but the glyph until the pointer is on it - the row belongs to the
 * field, and a button with a frame of its own beside every one of them would
 * read as the busier half of the page.
 *
 * The arrow is artwork and takes no colour from `color:`, the way the badges
 * and the caption glyphs do not. Its #A9AEB6 is in reverse.svg, the same grey
 * the labels on the left are set in - so a change here has to be made there. */

QToolButton#revertBtn {
    background: transparent;
    border: none;
    border-radius: 5px;
    padding: 0px;
}

QToolButton#revertBtn:hover   { background: #2A2C31; }
QToolButton#revertBtn:pressed { background: #26282C; }

/* The rule between the fields and the switches, and the one over the device
 * list's footer. The hairline grey, not the raised one: each divides two halves
 * of one page rather than standing where a window border would. Their height is
 * set in settingspage.cpp and devicelist.cpp, like the dots.
 *
 * One rule for both because they are meant to be the same line seen on two
 * pages - a change of colour here has to reach both or the window has two
 * kinds of divider. Each is a widget in a layout rather than a border on the
 * thing below it, which is what insets it from the window's edges: a border
 * runs the full width of what carries it, and that reads as a second window
 * frame rather than as a rule. */

QWidget#settingsSeparator,
QWidget#deviceFooterSeparator { background: #2B2D31; }

/* A switch. It is a QCheckBox - the thing it does is the thing a check box
 * does - wearing the pill the design draws, which arrives as artwork because
 * neither the track nor the knob on it can be drawn by a stylesheet. Two files,
 * one per state, the way the tabs in the title bar carry one per state: the
 * colours are in switch_on.svg and switch_off.svg, and this rule only says
 * which is which and how big it is.
 *
 * `spacing` is the gap between the pill and the label after it. The note under
 * that label is indented by the sum of the two - see SWITCH_TEXT_INDENT in
 * settingspage.cpp, which has to be answered if either number changes here. */

QCheckBox#settingsSwitch {
    background: transparent;
    color: #E8E9EC;
    font-size: 12px;
    spacing: 12px;
}

QCheckBox#settingsSwitch::indicator {
    width: 34px;
    height: 19px;
    image: url(:/assets/switch_off.svg);
}

QCheckBox#settingsSwitch::indicator:checked { image: url(:/assets/switch_on.svg); }

/* The note under a field. Muted, and a step down in size from the field it
 * belongs to, so it reads as a remark on that value rather than as another
 * thing to fill in. */

QLabel#settingsHint {
    color: #8D929A;
    font-size: 11px;
}

QWidget#deviceList,
QWidget#deviceRows,
QScrollArea#deviceScroll {
    background: transparent;
    border: none;
}

/* Rows are transparent until the pointer is over them - the list reads as a
 * column of devices rather than as a stack of cards. */

QWidget#deviceRow {
    background: transparent;
    border-radius: 7px;
}

QWidget#deviceRow:hover { background: #26282C; }

/* A held click, in the title bar and status bar's own #191A1D - darker than
 * the hover it is drawn over, and darker than the content behind that, so the
 * row reads as pressed into the window rather than merely dimmed. On a
 * property rather than :pressed, which Qt sets for the button classes and
 * never for a plain QWidget: see DeviceRow::mousePressEvent. It follows the
 * hover rule because the two are equally specific and a row is always hovered
 * while it is held, so the later of them is what shows. */

QWidget#deviceRow[pressed="true"] { background: #191A1D; }

/* The rules from here down used to be the mono half of the window and each
 * named the family itself. They name none now - the QWidget rule at the top
 * does it for the whole window - so what is left in a rule is what actually
 * differs from its neighbours: colour, size, weight.
 *
 * The regular cut travels in the resources alongside the semibold, which it
 * did not use to. That changes these rules rather than the ones naming a
 * weight: the semibold was the only face in the family, so every rule below
 * got it whether it asked or not. The ones that ask for no weight are in the
 * regular now - the lighter face they always named. */

/* The platform badge. Usually a glyph - see badgeIcon() in devicelist.cpp,
 * and note the artwork is drawn in the same #A9AEB6 the type rules below set,
 * since an icon cannot take its colour from `color:`. The type is for the
 * platforms with no glyph of their own, which name themselves in three
 * letters instead; mono, so those three are the same width every time. */

QLabel#deviceBadge {
    background: #2A2C31;
    border: 1px solid #3A3D43;
    border-radius: 6px;
    color: #A9AEB6;
    font-size: 12px;
    font-weight: 600;
}

QLabel#deviceName {
    color: #E8E9EC;
    font-size: 15px;
    font-weight: 600;
}

/* The second line of a row. The mount point is the bright half and the one the
 * eye is meant to land on - it is where the user goes to find the device -
 * with the address, and then the transfer counters that replace it, muted
 * beside it. Both are mono so neither shifts the row as its text changes: a
 * count of bytes changes width constantly, and a drive letter is a fixed
 * width the names above can be read against.
 *
 * #deviceMount exists on Windows only. See the note in devicelist.cpp. */

QLabel#deviceMount {
    color: #C7CBD1;
    font-size: 12px;
}

/* #deviceOs sits on the first line, beside the state dot, and is here rather
 * than with #deviceName above so that it and the counters are the same muted
 * type by construction - it is meant to read as a note on the row, not as a
 * second half of the name. */

QLabel#deviceDetail,
QLabel#deviceOs,
QLabel#deviceUploaded,
QLabel#deviceDownloaded {
    color: #8D929A;
    font-size: 12px;
}

/* The arrow before each counter has no rule of its own: it is a picture, and
 * a picture takes no colour from `color:`. Its #8D929A is the fill in
 * arrow-up.svg and arrow-down.svg, so the colour above has to be changed in
 * those two files as well to keep an arrow the shade of its own number. */

/* The state dots, on each row and once more in the status bar for the list as
 * a whole. 6px square from the code, so a 3px radius is what rounds them off. */

QLabel#deviceDot {
    background: #5F646C;
    border-radius: 3px;
}

QLabel#deviceDot[state="mounting"] { background: #E0A33C; }
QLabel#deviceDot[state="mounted"]  { background: #4EC97A; }
QLabel#deviceDot[state="failed"]   { background: #E0574C; }

/* The second line of a failed row carries the reason, and takes the dot's own
 * colour to say so - it is the one thing on a row that is a fault rather than a
 * fact about the device. Same red, and the same red the tray's dot is drawn in
 * from mainwindow.cpp, which has to be changed with it. */

QLabel#deviceDetail[state="failed"] { color: #E0574C; }

QLabel#deviceEmptyTitle {
    color: #E8E9EC;
    font-size: 15px;
    font-weight: 600;
}

QLabel#deviceEmptyText {
    color: #8D929A;
    font-size: 12px;
}

/* ---------------------------------------------------- the device list's footer
 * The strip under the rows: a line saying why a device might not have been found
 * on its own, and the button that connects one by address. Outside the scroll
 * area, so it stays put while the rows move under it.
 *
 * Nothing is drawn here. The line over it is #deviceFooterSeparator, a widget of
 * its own in the footer's layout - see the rule it shares with the settings
 * page's - and a fill would make the footer a second surface in a window that
 * has only ever had one. */

QWidget#deviceFooter {
    background: transparent;
}

/* The same muted grey a note under a settings field is set in. It is the same
 * kind of thing - a remark about the control beside it - and reads as one by
 * being the same colour. */
QLabel#deviceFooterHint {
    color: #8D929A;
    font-size: 12px;
}

/* The design's secondary button, and the same one the settings page's Choose is:
 * a raised fill inside a border a shade lighter than the fields'. Secondary
 * deliberately - the list finding devices by itself is the ordinary way in, and
 * this is the way round it.
 *
 * A device row's Retry is here for that reason and no other: it is the same
 * button doing the same kind of job, and it is set at the same size rather than
 * shrunk to sit inside a row - a row has the height for it, and a button drawn
 * smaller than every other button in the window reads as a lesser one.
 *
 * The dialog that button opens ends in a pair of them, and its Cancel is named
 * here rather than dressed separately: it is the same button doing the same kind
 * of job - the way out of a choice rather than the choice itself. Its Connect is
 * the one that differs, and it is further down under the dialog's own rules.
 *
 * Both have to name themselves past the plain QPushButton rule further down,
 * which is what dresses an ordinary dialog's buttons - so what is set here is a
 * whole button and not a handful of corrections to that one. */

QPushButton#deviceRetryBtn,
QPushButton#manualConnectBtn,
QPushButton#dialogCancelBtn,
QPushButton#dialogQuitBtn {
    background: #26282C;
    border: 1px solid #3D4046;
    border-radius: 6px;
    color: #C7CBD1;
    font-size: 12px;
    padding: 4px 12px;
    min-width: 0px;
}

QPushButton#deviceRetryBtn:hover,
QPushButton#manualConnectBtn:hover,
QPushButton#dialogCancelBtn:hover { background: #2F3238; }

QPushButton#deviceRetryBtn:pressed,
QPushButton#manualConnectBtn:pressed,
QPushButton#dialogCancelBtn:pressed { background: #212226; }

/* The list is the only thing that scrolls, so this is the whole scrollbar. No
 * buttons at the ends - the arrows are a Windows 7 idea that nothing in this
 * window's design has room for. */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px;
}

QScrollBar::handle:vertical {
    background: #34363B;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover { background: #45484F; }

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0px; }

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: transparent; }

/* --------------------------------------------------------------- dialogs
 * Two of them: the no-tray close question, and the manual connect dialog the
 * device list's footer opens. Both need styling rather than being left native:
 * the QWidget rule at the top of this file already gives every label in them
 * near-white text, so without a dark background here it would be pale text on
 * the system's pale dialog.
 *
 * The frame stays native on both - a modal dialog with the system's own title
 * bar is the right thing, and they are the only windows in the app that have
 * one. */

QDialog, QMessageBox {
    background: #1E1F22;
}

QMessageBox QLabel {
    color: #E8E9EC;
    background: transparent;
}

/* ------------------------------------------------- the manual connect dialog
 * An address and a port, asked for the same way the settings page asks for its
 * own values: a muted label on the left, the value on the right in the
 * near-white the fields are set in. The three rules below are the settings
 * page's #settingsLabel, #settingsInput and #settingsHint under names of their
 * own - a dialog is not the settings page, and the day one of the two wants a
 * different size is the day sharing the names would be in the way. */

/* This dialog wears no system frame either - see Qt::FramelessWindowHint in
 * manualconnectdialog.cpp - so its frame is drawn by the three widgets stacked
 * inside it, exactly as the main window's is: #titleBar owns the top two
 * corners, #dialogButtonBar the bottom two, and #dialogContent the straight run
 * between them, each carrying the same 1px #34363B outline down its own outer
 * edges so the three read as one border.
 *
 * The title bar needs no rule of its own here. It is the same TitleBar the
 * window wears, under the same object name, so it is already dressed by the
 * rules at the top of this file - which is the point of it being that widget
 * rather than one built to look like it.
 *
 * The dialog itself must paint nothing, for the same reason QMainWindow must:
 * it is translucent, and a fill here would put the square corners straight
 * back. It has to say so past the QDialog rule above, which is what dresses an
 * ordinary dialog - the close question, and any QMessageBox. */

QDialog#manualConnectDialog,
QDialog#closeChoiceDialog { background: transparent; }

QWidget#dialogContent {
    background: #1E1F22;
    border-left: 1px solid #34363B;
    border-right: 1px solid #34363B;
}

/* The foot of the dialog, and the same tokens QStatusBar closes the main window
 * with: the deeper surface, the hairline over it, and the two rounded corners.
 * The one difference is that the status bar has a fixed height to fill and this
 * is as tall as the buttons on it. */

QWidget#dialogButtonBar {
    background: #191A1D;
    border-top: 1px solid #2B2D31;
    border-left: 1px solid #34363B;
    border-right: 1px solid #34363B;
    border-bottom: 1px solid #34363B;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
}

/* The one line of a dialog meant to be read first - the question the close
 * dialog asks, so far. The near-white and the weight the device list titles its
 * empty state in, because it is the same kind of line: the thing being said,
 * with everything under it explaining it. */

QLabel#dialogHeading {
    color: #E8E9EC;
    font-size: 15px;
    font-weight: 600;
}

QLabel#dialogIntro {
    color: #A9AEB6;
    font-size: 12px;
}

QLabel#dialogLabel {
    color: #A9AEB6;
    font-size: 12px;
}

QLabel#dialogNote {
    color: #8D929A;
    font-size: 12px;
}

QLineEdit#dialogInput {
    background: #191A1D;
    border: 1px solid #3D4046;
    border-radius: 6px;
    color: #E8E9EC;
    font-size: 12px;
    padding: 4px 8px;
    selection-background-color: #2F3238;
    selection-color: #E8E9EC;
}

QLineEdit#dialogInput:focus { border-color: #5F646C; }

/* The address box. Four fields and the dots between them wearing one border, so
 * that what is really four QLineEdits reads as the single field an address is -
 * see IPv4Edit in manualconnectdialog.cpp for why it is four.
 *
 * Everything a field carries is on the box: the fill, the border, the radius.
 * The octets inside it carry none of it, or there would be four sunken boxes
 * inside a fifth. */

QWidget#ipEdit {
    background: #191A1D;
    border: 1px solid #3D4046;
    border-radius: 6px;
}

/* What :focus would say if a stylesheet could ask it of a container. It cannot -
 * the focus is on one of the children - so the box carries the answer as a
 * property instead, set from IPv4Edit::refreshFocused(). Same lift as the port
 * field above, so the two fields answer the cursor alike. */
QWidget#ipEdit[focused="true"] { border-color: #5F646C; }

QLineEdit#ipOctet {
    background: transparent;
    border: none;
    color: #E8E9EC;
    font-size: 12px;
    padding: 5px 0px;
    selection-background-color: #2F3238;
    selection-color: #E8E9EC;
}

/* The separators, drawn rather than typed - which is the point of the control.
 * Muted, so the four numbers are what is read and the dots only divide them. */
QLabel#ipDot {
    background: transparent;
    color: #8D929A;
    font-size: 12px;
}

/* Connect is the button that does the thing, and the only primary button in the
 * application: the one light fill in a window that is otherwise all dark
 * surfaces, which is what makes it the first thing found in the dialog. The tabs
 * in the title bar are the only other place a light fill appears, and for the
 * same reason - and like them, what is drawn on it has to be dark to read.
 *
 * It shares its shape with the Cancel beside it - the radius, the type, the
 * padding, the 1px border - so the two are one pair of buttons in two weights
 * rather than two different buttons. Only the colours differ, and the border is
 * the fill's own colour rather than a line around it: a dark outline on a light
 * button reads as a hole cut in it, but a border of some width has to be there
 * or this button would stand a pixel shorter than Cancel.
 *
 * No :default rule. The generic one further down lifts a default button's border
 * to mark it as the one Return presses, which this fill already says louder -
 * and an ID selector outranks that rule anyway, so there is nothing to undo. */

QPushButton#dialogConnectBtn,
QPushButton#dialogHideBtn {
    background: #C7CBD1;
    border: 1px solid #C7CBD1;
    border-radius: 6px;
    color: #0C0D0F;
    font-size: 12px;
    padding: 4px 12px;
}

QPushButton#dialogConnectBtn:hover,
QPushButton#dialogHideBtn:hover {
    background: #E8E9EC;
    border-color: #E8E9EC;
}

QPushButton#dialogConnectBtn:pressed,
QPushButton#dialogHideBtn:pressed {
    background: #A9AEB6;
    border-color: #A9AEB6;
}

/* Disabled until there is a whole address and a port to send - see
 * refreshControls() - and it has to look it, or a button that ignores clicks
 * reads as broken rather than as waiting. Back to the dark surfaces the rest of
 * the window is in, which is as far from the primary fill as this palette goes.
 *
 * Last of the four deliberately. It is exactly as specific as the two states
 * above it, and Qt sets :hover from the pointer's position whether or not the
 * widget is enabled - so a disabled button under the pointer matches both, and
 * only the later rule keeps it from lighting up as though it could be pressed. */

QPushButton#dialogConnectBtn:disabled {
    background: #26282C;
    border-color: #2B2D31;
    color: #5F646C;
}

/* A dialog's buttons are one group and should be one size, which they are not
 * left to themselves: "Cancel" and "Connect" differ by a character, and "Quit"
 * by three more, and at this type that is a difference the eye reads as a
 * mistake rather than as a shorter word. */

QPushButton#dialogCancelBtn,
QPushButton#dialogConnectBtn,
QPushButton#dialogQuitBtn,
QPushButton#dialogHideBtn { min-width: 60px; }

QPushButton {
    background: #2F3238;
    border: 1px solid #34363B;
    border-radius: 6px;
    color: #E8E9EC;
    padding: 6px 16px;
    min-width: 80px;
}

QPushButton:hover   { background: #34363B; }
QPushButton:pressed { background: #26282C; }

/* The default button is the safe one here (Hide), so it gets the emphasis. */
QPushButton:default { border-color: #5F646C; }

/* And the one that loses work gets the error red, but only on the way to
 * being pressed - unarmed it sits with its neighbours. */
QPushButton#dialogQuitBtn:hover   { background: #C42B1C; border-color: #C42B1C; color: #FFFFFF; }
QPushButton#dialogQuitBtn:pressed { background: #B2271A; border-color: #B2271A; color: #FFFFFF; }

/* --------------------------------------------------------- tray context menu */

QMenu {
    background: #1E1F22;
    border: 1px solid #34363B;
    border-radius: 8px;
    padding: 6px;
}

/* The left padding is the icon's column, not a margin: Qt draws QMenu::icon inside it and
 * starts the text after it, so it has to be wide enough for the 16px icon plus the inset in
 * front of it. 12px, what this was before there were icons, would put the text on top of
 * them. Whatever is left over past 12 + 16 is the gap between icon and label. */
QMenu::item {
    background: transparent;
    color: #E8E9EC;
    padding: 7px 30px 7px 12px;
    border-radius: 6px;
    margin: 1px 2px;
}

/* Left-aligned in that column by default, which is flush against the item's edge. Nudged in
 * so it sits under the same 12px inset the text used to have. */
QMenu::icon { left: 7px; }

QMenu::item:selected { background: #2A2C31; }
QMenu::item:disabled { color: #5F646C; }

QMenu::separator {
    height: 1px;
    background: #2B2D31;
    margin: 5px 8px;
}

/* -------------------------------------------------------------------- tooltip
 * The tray icon has one ("FileDonkey"), and it is a top-level window of its
 * own, so it needs styling here or it stays system-default. */

QToolTip {
    background: #26282C;
    color: #E8E9EC;
    border: 1px solid #34363B;
    border-radius: 6px;
    padding: 4px 8px;
}
