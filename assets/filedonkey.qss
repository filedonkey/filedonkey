/* FileDonkey - dark skin.
 *
 * Palette taken from the design mockups:
 *
 *   #1E1F22  panel / window          #E8E9EC  text, primary
 *   #191A1D  deeper surfaces         #C7CBD1  text, bright secondary
 *   #141518  deepest                 #A9AEB6  text, secondary
 *   #26282C  rows, raised            #8D929A  text, muted
 *   #2A2C31  hover                   #7E838B  text, micro-labels
 *   #2F3238  controls                #5F646C  text, disabled
 *   #34363B  borders, raised
 *   #2B2D31  borders, hairline       #4EC97A  mounted
 *                                    #E0A33C  busy
 *                                    #E0564C  error     (unused so far)
 *
 * Two of the accent three are on the device list's state dots. The error red
 * has nowhere to go yet: a mount that fails takes its row with it - LocalNode
 * forgets the peer so the next broadcast can start it over - so there is no
 * failed state left on screen to colour.
 */

/* Type and colour for everything. Deliberately no background here: a bare
 * QWidget background rule paints over every child widget in the app.
 *
 * No family either, and that is the point: it is the desktop's own UI font,
 * set on the application in main.cpp. This rule used to name Segoe UI, which
 * dressed the Windows build and left the other two falling past it to the
 * `sans-serif` generic - Helvetica on macOS, fontconfig's guess on Linux,
 * neither of them the font those desktops actually use. See applyFonts(). */
QWidget {
    color: #E8E9EC;
    font-size: 13px;
}

/* The window frame is drawn by the three widgets stacked inside it, not by the
 * window: #titleBar owns the top two corners, QStatusBar the bottom two, and
 * #centralwidget the straight run between them. Each carries the same 1px
 * #34363B outline down its own outer edges so the three read as one border.
 *
 * QMainWindow itself must paint nothing - it is translucent (see
 * WA_TranslucentBackground in MainWindow) and any fill here would put the
 * square corners straight back. */

QMainWindow {
    background: transparent;
}

/* The shadow caster. Never seen directly - the title bar, the content and the
 * status bar cover it - so the only thing that matters here is that its shape
 * matches theirs, or the blur it throws would not follow the frame's corners.
 * The fill is the corner colour, so a rounding difference of a pixel at the
 * radius reads as the frame rather than as a seam. */

QWidget#windowShadow {
    background: #191A1D;
    border-radius: 8px;
}

QMainWindow > QWidget#centralwidget {
    background: #1E1F22;
    border-left: 1px solid #34363B;
    border-right: 1px solid #34363B;
}

/* ----------------------------------------------------------------- title bar
 * Same two tokens as the status bar, so the window is bookended by them. The
 * native title bar is off - see Qt::FramelessWindowHint in MainWindow - and
 * this sits in the slot the (empty) menu bar used to have. */

QWidget#titleBar {
    background: #191A1D;
    border-top: 1px solid #34363B;
    border-left: 1px solid #34363B;
    border-right: 1px solid #34363B;
    border-bottom: 1px solid #2B2D31;
    border-top-left-radius: 8px;
    border-top-right-radius: 8px;
}

QLabel#titleBarTitle {
    color: #A9AEB6;
    font-size: 12px;
}

/* Size comes from the layout, not from here - see captionButton() in
 * titlebar.cpp. Square, flush and full height, the way Windows draws them, so
 * the hover fill runs the whole button rather than floating inside it.
 *
 * Only the fills live here. The glyphs are SVG icons, one file per state under
 * assets/caption_*.svg, and an icon does not take its colour from `color:` -
 * so the greys below are backgrounds, and the marks drawn on top of them are
 * coloured in the files. The two palettes have to be read together. */

QToolButton#minimiseBtn,
QToolButton#maximiseBtn,
QToolButton#closeBtn {
    background: transparent;
    border: none;

    /* Full height means these run over the bar's own top border and bottom
     * hairline, so a hover fill would otherwise punch a 46px hole in the
     * window's outline. Carrying the same two lines themselves closes it. */
    border-top: 1px solid #34363B;
    border-bottom: 1px solid #2B2D31;

    border-radius: 0px;
    padding: 0px;
}

/* The one exception: this button's outer corner is the window's, so its hover
 * fill has to follow the same curve or it squares the corner off on hover.
 * 7px rather than 8 - the bar's radius measured inside its 1px border. */
QToolButton#closeBtn { border-top-right-radius: 7px; }

QToolButton#minimiseBtn:hover   { background: #2F3238; }
QToolButton#minimiseBtn:pressed { background: #2A2C31; }

/* Maximise is present but dead - the window is a fixed size. It has to read as
 * unavailable at a glance rather than as a button that did nothing when
 * clicked, so its glyph is drawn in the disabled grey used for dead menu
 * entries (#4A4E55, in caption_maximise.svg). Nothing to set here: the button
 * keeps the transparent background above, and Qt sends a disabled widget
 * neither hover nor pressed, which is what we want anyway. */

/* The one place the error red earns its keep so far. */
QToolButton#closeBtn:hover   { background: #C42B1C; }
QToolButton#closeBtn:pressed { background: #B2271A; }

/* ---------------------------------------------------------------- status bar */

QStatusBar {
    background: #191A1D;
    border-top: 1px solid #2B2D31;
    border-left: 1px solid #34363B;
    border-right: 1px solid #34363B;
    border-bottom: 1px solid #34363B;
    border-bottom-left-radius: 8px;
    border-bottom-right-radius: 8px;
    min-height: 30px;
}

/* Without this every widget added to the bar gets a sunken 3D frame drawn
 * around it by the native style. */
QStatusBar::item { border: 0px; }

/* ------------------------------------------------- the status bar's contents
 * One line at each end. On the left the version and the stage the project is
 * in, which used to be part of the window title; on the right, built by the
 * device list and put here by the window, the same state dot the rows carry
 * and a count of them. The transfer counters that used to sit on the right are
 * on the rows now - see #deviceDetail below.
 *
 * Both ends are the same muted 11px, so neither reads as the more important
 * of the two and neither competes with the list above them. */

QLabel#versionLbl {
    color: #8D929A;
    font-size: 11px;
}

QWidget#deviceSummary { background: transparent; }

QLabel#deviceCountLbl {
    color: #8D929A;
    font-size: 11px;
}

/* ---------------------------------------------------------- the device list
 * Everything between the title bar and the status bar: a scrolling column of
 * rows, or the empty state while nothing has been found. It carries no heading
 * of its own - the window is the list, and the count that would have titled it
 * is in the status bar instead.
 *
 * Sizes that decide the shape of a thing - the 30px badge, the 6px dots - are
 * set in devicelist.cpp rather than here, because QSS sizes the content box
 * and each border would have to be subtracted from the number by hand. What is
 * left here is colour, type and roundness. */

QWidget#deviceList,
QWidget#deviceRows,
QScrollArea#deviceScroll {
    background: transparent;
    border: none;
}

/* Rows are transparent until the pointer is over them - the list reads as a
 * column of devices rather than as a stack of cards. */

QWidget#deviceRow {
    background: transparent;
    border-radius: 7px;
}

QWidget#deviceRow:hover { background: #26282C; }

/* Everything from here down is mono, and the family list is the same in each
 * rule. Inconsolata is the one we mean; it ships with no desktop at all, so it
 * travels in the resources and applyFonts() registers it at startup. Both
 * spellings are asked for: the file carries a typographic family of
 * "Inconsolata" and a legacy one of "Inconsolata SemiBold", and which of the
 * two a Qt platform backend registers is its own business - 6.9 on Windows
 * happens to register both. The rest of the list is what is left if the
 * resource ever fails to register: Cascadia
 * Mono and Consolas on Windows, and the generic, which is Menlo on macOS and
 * whatever fontconfig answers with on Linux.
 *
 * The file is the SemiBold cut and is the only face in the family, so the two
 * rules below that ask for no weight get it too. Adding Inconsolata-Regular to
 * the resources is what would give them the lighter face they name. */

/* The platform badge. Usually a glyph - see badgeIcon() in devicelist.cpp,
 * and note the artwork is drawn in the same #A9AEB6 the type rules below set,
 * since an icon cannot take its colour from `color:`. The type is for the
 * platforms with no glyph of their own, which name themselves in three
 * letters instead; mono, so those three are the same width every time. */

QLabel#deviceBadge {
    background: #2A2C31;
    border: 1px solid #3A3D43;
    border-radius: 6px;
    color: #A9AEB6;
    font-family: "Inconsolata", "Inconsolata SemiBold", "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
    font-weight: 600;
}

QLabel#deviceName {
    color: #E8E9EC;
    font-family: "Inconsolata", "Inconsolata SemiBold", "Cascadia Mono", Consolas, monospace;
    font-size: 13px;
    font-weight: 600;
}

/* The second line of a row. The mount point is the bright half and the one the
 * eye is meant to land on - it is where the user goes to find the device -
 * with the address, and then the transfer counters that replace it, muted
 * beside it. Both are mono so neither shifts the row as its text changes: a
 * count of bytes changes width constantly, and a drive letter is a fixed
 * width the names above can be read against.
 *
 * #deviceMount exists on Windows only. See the note in devicelist.cpp. */

QLabel#deviceMount {
    color: #C7CBD1;
    font-family: "Inconsolata", "Inconsolata SemiBold", "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
}

/* #deviceOs sits on the first line, beside the state dot, and is here rather
 * than with #deviceName above so that it and the counters are the same muted
 * type by construction - it is meant to read as a note on the row, not as a
 * second half of the name. */

QLabel#deviceDetail,
QLabel#deviceOs,
QLabel#deviceUploaded,
QLabel#deviceDownloaded {
    color: #8D929A;
    font-family: "Inconsolata", "Inconsolata SemiBold", "Cascadia Mono", Consolas, monospace;
    font-size: 11px;
}

/* The arrow before each counter has no rule of its own: it is a picture, and
 * a picture takes no colour from `color:`. Its #8D929A is the fill in
 * arrow-up.svg and arrow-down.svg, so the colour above has to be changed in
 * those two files as well to keep an arrow the shade of its own number. */

/* The state dots, on each row and once more in the status bar for the list as
 * a whole. 6px square from the code, so a 3px radius is what rounds them off. */

QLabel#deviceDot {
    background: #5F646C;
    border-radius: 3px;
}

QLabel#deviceDot[state="mounting"] { background: #E0A33C; }
QLabel#deviceDot[state="mounted"]  { background: #4EC97A; }

QLabel#deviceEmptyTitle {
    color: #E8E9EC;
    font-size: 13px;
    font-weight: 600;
}

QLabel#deviceEmptyText {
    color: #8D929A;
    font-size: 11px;
}

/* The list is the only thing that scrolls, so this is the whole scrollbar. No
 * buttons at the ends - the arrows are a Windows 7 idea that nothing in this
 * window's design has room for. */

QScrollBar:vertical {
    background: transparent;
    width: 10px;
    margin: 4px 2px;
}

QScrollBar::handle:vertical {
    background: #34363B;
    border-radius: 3px;
    min-height: 24px;
}

QScrollBar::handle:vertical:hover { background: #45484F; }

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical { height: 0px; }

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical { background: transparent; }

/* --------------------------------------------------------------- dialogs
 * The no-tray close dialog is the only one so far. It needs styling rather
 * than being left native: the QWidget rule at the top of this file already
 * gives every label in it near-white text, so without a dark background here
 * it would be pale text on the system's pale dialog.
 *
 * The frame stays native - a modal dialog with the system's own title bar is
 * the right thing, and it is the only window in the app that has one. */

QDialog, QMessageBox {
    background: #1E1F22;
}

QMessageBox QLabel {
    color: #E8E9EC;
    background: transparent;
}

QPushButton {
    background: #2F3238;
    border: 1px solid #34363B;
    border-radius: 6px;
    color: #E8E9EC;
    padding: 6px 16px;
    min-width: 80px;
}

QPushButton:hover   { background: #34363B; }
QPushButton:pressed { background: #26282C; }

/* The default button is the safe one here (Hide), so it gets the emphasis. */
QPushButton:default { border-color: #5F646C; }

/* And the one that loses work gets the error red, but only on the way to
 * being pressed - unarmed it sits with its neighbours. */
QPushButton#dialogQuitBtn:hover   { background: #C42B1C; border-color: #C42B1C; color: #FFFFFF; }
QPushButton#dialogQuitBtn:pressed { background: #B2271A; border-color: #B2271A; color: #FFFFFF; }

/* --------------------------------------------------------- tray context menu */

QMenu {
    background: #1E1F22;
    border: 1px solid #34363B;
    border-radius: 8px;
    padding: 6px;
}

QMenu::item {
    background: transparent;
    color: #E8E9EC;
    padding: 7px 30px 7px 12px;
    border-radius: 6px;
    margin: 1px 2px;
}

QMenu::item:selected { background: #2A2C31; }
QMenu::item:disabled { color: #5F646C; }

QMenu::separator {
    height: 1px;
    background: #2B2D31;
    margin: 5px 8px;
}

/* -------------------------------------------------------------------- tooltip
 * The tray icon has one ("FileDonkey"), and it is a top-level window of its
 * own, so it needs styling here or it stays system-default. */

QToolTip {
    background: #26282C;
    color: #E8E9EC;
    border: 1px solid #34363B;
    border-radius: 6px;
    padding: 4px 8px;
}
